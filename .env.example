# Copy to .env.local (git-ignored) for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for deployments.
# With nothing set, `pnpm dev` runs against a local database as a single local user.

# ---------------------------------------------------------------- Server (API only)

# Supabase Postgres through the transaction pooler (Supabase → Connect → Transaction
# pooler, port 6543). Unset = local in-process database in ./data/pglite.
DATABASE_URL=

# Optional: connection for `pnpm db:migrate` (schema changes). Use the session pooler
# (port 5432) or direct connection string. Defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=

# Auth0 API that protects /api: your tenant domain (e.g. your-tenant.eu.auth0.com) and
# the API identifier (audience). Unset = local development as a single local user.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ---------------------------------------------------------- Browser (public, build time)

# The Auth0 single-page application. These are public identifiers, not secrets.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
