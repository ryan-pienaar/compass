{
  "name": "compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch --watch-preserve-output server/index.ts --dev\" \"vite\"",
    "dev:api": "node --watch server/index.ts --dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "app": "node scripts/launch.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "A Quadrant II planner built on Habits 1-3 of The 7 Habits of Highly Effective People",
  "engines": {
    "node": ">=24"
  }
}
